# ==============================================================================
# OpenShorts Environment Configuration (Google Colab / Self-Hosted)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API & Models
# ------------------------------------------------------------------------------
# Masukkan API Key Gemini Anda dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model utama untuk deteksi momen viral, evaluasi klip, & pemilihan layout
GEMINI_MODEL=gemini-3.1-flash-lite

# Model teks Thumbnail Studio: judul kreatif, kritik judul, & perancang konsep visual
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash

# Model generasi visual gambar thumbnail
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ------------------------------------------------------------------------------
# Local Whisper (Speech-to-Text)
# ------------------------------------------------------------------------------
# Pilihan model Whisper: tiny, base, small, medium, large-v3-turbo
# Di Google Colab dengan GPU (T4/V100/A100/L4): gunakan device=cuda & compute=float16
# Jika berjalan tanpa GPU (CPU saja): ubah WHISPER_DEVICE=cpu & WHISPER_COMPUTE=int8
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# Backend transkripsi
TRANSCRIBE_BACKEND=whisper
ASR_GPU_CONCURRENCY=1

# ------------------------------------------------------------------------------
# Video Encoding
# ------------------------------------------------------------------------------
# 'auto' mendeteksi hardware NVENC (GPU Colab) otomatis dan fallback ke x264 jika perlu
FFMPEG_ENCODER=auto
